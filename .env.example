# Copy to .env.local and fill in. The same variables must be set in the host
# (e.g. Vercel) or the deployed form fails while local works.

# From resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Your own Resend account address. Without a verified sending domain, Resend
# only delivers to this address (anything else is a 403).
CONTACT_TO_EMAIL=you@example.com

# Optional. Defaults to the Resend test sender, "Portfolio <onboarding@resend.dev>".
# Set this only after verifying a domain at resend.com/domains.
# RESEND_FROM=Portfolio <hello@yourdomain.com>

# Optional. Absolute base URL for Open Graph/Twitter tags. Leave unset on Vercel —
# VERCEL_PROJECT_PRODUCTION_URL is picked up automatically. Set it once you point
# a custom domain at the deploy, e.g. https://yourname.dev
# NEXT_PUBLIC_SITE_URL=https://yourname.dev
